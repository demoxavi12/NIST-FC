# NIST FC API environment variables (docs/API.md §38, docs/AUTH.md §46).
# Copy to server/.env for local development. Never commit a real .env file.
# In production, set these on the hosting platform instead.

# Server
# Required: development | production
NODE_ENV=
# Optional: defaults to 5000
PORT=

# Database
# Required. The database name is taken from the URI path,
# e.g. mongodb+srv://<user>:<password>@<cluster-host>/nist-fc
MONGODB_URI=

# Authentication (required from Phase 3)
JWT_SECRET=
JWT_EXPIRES_IN=
COOKIE_NAME=
COOKIE_SECURE=
COOKIE_SAME_SITE=

# CORS / deployment
# Required: the frontend origin, e.g. http://localhost:5173 in development
CLIENT_URL=

# Cloudinary (required in production; optional with a warning in development)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Upload limits (read when uploads are implemented)
MAX_IMAGE_SIZE_MB=
MAX_MEMORY_IMAGES=

# Initial admin seed (used only by the admin seed script)
ADMIN_NAME=
ADMIN_EMAIL=
ADMIN_PASSWORD=
