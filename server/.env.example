# NIST FC API environment variables (docs/API.md §38, docs/AUTH.md §46).
# Copy to server/.env for local development. Never commit a real .env file.
# In production, set these on the hosting platform instead.

# Server
# Required: development | production
NODE_ENV=
# Optional: defaults to 5000
PORT=

# Database
# Required. The database name is taken from the URI path,
# e.g. mongodb+srv://<user>:<password>@<cluster-host>/nist-fc
MONGODB_URI=

# Authentication (required)
# At least 32 random characters; never the documented example value
JWT_SECRET=
# <number><s|m|h|d>, e.g. 1d
JWT_EXPIRES_IN=
# e.g. nist_fc_token
COOKIE_NAME=
# true or false; must be true in production
COOKIE_SECURE=
# lax or strict; V1 uses lax
COOKIE_SAME_SITE=

# CORS / deployment
# Required: the frontend origin, e.g. http://localhost:5173 in development
CLIENT_URL=

# Cloudinary (required: player photos are required)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Upload limits
# Optional: maximum image size in MB (default 5, at most 10)
MAX_IMAGE_SIZE_MB=
# Optional: gallery photos accepted per upload request (default 20, 1-50).
# Not the total per memory, which is fixed at 100 photos.
MAX_MEMORY_IMAGES=

# Initial admin seed (used only by `npm run seed:admin`)
# ADMIN_PASSWORD: 8+ characters with uppercase, lowercase, number and special
# character, at most 72 bytes. Remove these values after seeding.
ADMIN_NAME=
ADMIN_EMAIL=
ADMIN_PASSWORD=
